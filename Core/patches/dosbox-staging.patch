@@ -2554,6 +2554,22 @@ static void CreateDefaultBinds()
 	LOG_MSG("MAPPER: Loaded default key bindings");
 }
 
+// DOS Boxer: runs a registered hotkey handler by name (e.g. "cycleup",
+// "pause", "swapimg") as if its key were pressed and released, so the host
+// can offer the same actions in its own UI. Emulator thread only.
+bool DOSBOXER_TriggerHandler(const char* name)
+{
+	const std::string wanted = std::string("hand_") + name;
+	for (auto* handler_event : handlergroup) {
+		if (wanted == handler_event->GetName()) {
+			handler_event->Active(true);
+			handler_event->Active(false);
+			return true;
+		}
+	}
+	return false;
+}
