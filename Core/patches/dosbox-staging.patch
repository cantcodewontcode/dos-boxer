diff --git a/src/dosboxer/dosboxer_hooks.h b/src/dosboxer/dosboxer_hooks.h
new file mode 100644
index 000000000..dde85c561
--- /dev/null
+++ b/src/dosboxer/dosboxer_hooks.h
@@ -0,0 +1,36 @@
+// DOS Boxer embedding hooks.
+//
+// The core provides weak default definitions (stock behaviour), so the plain
+// dosbox executable is unchanged. The DOS Boxer host library overrides them.
+
+#ifndef DOSBOXER_HOOKS_H
+#define DOSBOXER_HOOKS_H
+
+class RenderBackend;
+
+// Returns a host-owned render backend, or nullptr to use the built-in ones.
+RenderBackend* DOSBOXER_CreateRenderBackend();
+
+// True when the host pulls audio via DOSBOXER_MixerPull instead of SDL.
+bool DOSBOXER_HostAudioEnabled();
+
+// Provided by the mixer: fills `num_frames` interleaved stereo float frames.
+void DOSBOXER_MixerPull(float* interleaved_stereo, int num_frames);
+
+// True when SDL quit events should be ignored: the host shuts the emulator
+// down itself, and SDL can queue stray quits when it outlives a run.
+bool DOSBOXER_IgnoreSdlQuit();
+
+// Called on the emulator thread from the main loop, so the host can safely
+// change emulator state (e.g. mount drives while DOS is running).
+void DOSBOXER_ProcessHostRequests();
+
+// Provided by the mapper: runs a hotkey handler ("cycleup", "cycledown",
+// "pause", "swapimg", …) by name. Emulator thread only.
+bool DOSBOXER_TriggerHandler(const char* name);
+
+// DOS has finished (its shell exited): the host may end the session now,
+// before DOSBox tears down its subsystems.
+void DOSBOXER_ShellFinished();
+
+#endif
